<resources>
    <style name="Theme.Nuraya" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/nuraya_ivory</item>
        <item name="android:navigationBarColor">@color/nuraya_ivory</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/nuraya_ivory</item>
        <item name="android:colorAccent">@color/nuraya_emerald</item>
        <item name="android:windowSplashScreenBackground">@color/nuraya_emerald</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
