{"surah":92,"source":"Transliterasi Latin Indonesia · EQuran.id API v2","sourceUrl":"https://equran.id/api/v2/surat/92","verses":[{"ayah":1,"latin":"Wal-laili iżā yagsyā."},{"ayah":2,"latin":"Wan-nahāri iżā tajallā."},{"ayah":3,"latin":"Wa mā khalaqaż-żakara wal-unṡā."},{"ayah":4,"latin":"Inna sa‘yakum lasyattā."},{"ayah":5,"latin":"Fa ammā man a‘ṭā wattaqā."},{"ayah":6,"latin":"Wa ṣaddaqa bil-ḥusnā."},{"ayah":7,"latin":"Fa sanuyassiruhū lil-yusrā."},{"ayah":8,"latin":"Wa ammā man bakhila wastagnā."},{"ayah":9,"latin":"Wa każżaba bil-ḥusnā."},{"ayah":10,"latin":"Fa sanuyassiruhū lil-‘usrā."},{"ayah":11,"latin":"Wa mā yugnī ‘anhu māluhū iżā taraddā."},{"ayah":12,"latin":"Inna ‘alainā lal-hudā."},{"ayah":13,"latin":"Wa inna lanā lal-ākhirata wal-ūlā."},{"ayah":14,"latin":"Fa anżartukum nāran talaẓẓā."},{"ayah":15,"latin":"Lā yaṣlāhā illal-asyqā."},{"ayah":16,"latin":"Allażī każżaba wa tawallā."},{"ayah":17,"latin":"Wa sayujannabuhal-atqā."},{"ayah":18,"latin":"Allażī yu'tī mālahū yatazakkā."},{"ayah":19,"latin":"Wa mā li'aḥadin ‘indahū min ni‘matin tujzā."},{"ayah":20,"latin":"Illabtigā'a wajhi rabbihil-a‘lā."},{"ayah":21,"latin":"Wa lasaufa yarḍā."}]}
