{"surah":93,"source":"Transliterasi Latin Indonesia · EQuran.id API v2","sourceUrl":"https://equran.id/api/v2/surat/93","verses":[{"ayah":1,"latin":"Waḍ-ḍuḥā."},{"ayah":2,"latin":"Wal-laili iżā sajā."},{"ayah":3,"latin":"Mā wadda‘aka rabbuka wa mā qalā."},{"ayah":4,"latin":"Wa lal-ākhiratu khairul laka minal-ūlā."},{"ayah":5,"latin":"Wa lasaufa yu‘ṭīka rabbuka fa tarḍā."},{"ayah":6,"latin":"Alam yajidka yatīman fa āwā."},{"ayah":7,"latin":"Wa wajadaka ḍāllan fa hadā."},{"ayah":8,"latin":"Wa wajadaka ‘ā'ilan fa agnā."},{"ayah":9,"latin":"Fa ammal-yatīma falā taqhar."},{"ayah":10,"latin":"Wa ammas-sā'ila falā tanhar."},{"ayah":11,"latin":"Wa ammā bini‘mati rabbika fa ḥaddiṡ."}]}
