{"surah":87,"source":"Transliterasi Latin Indonesia · EQuran.id API v2","sourceUrl":"https://equran.id/api/v2/surat/87","verses":[{"ayah":1,"latin":"Sabbiḥisma rabbikal-a‘lā."},{"ayah":2,"latin":"Allażī khalaqa fasawwā."},{"ayah":3,"latin":"Wal-lażī qaddara fahadā."},{"ayah":4,"latin":"Wal-lażī akhrajal-mar‘ā."},{"ayah":5,"latin":"Fa ja‘alahū guṡā'an aḥwā."},{"ayah":6,"latin":"Sanuqri'uka falā tansā."},{"ayah":7,"latin":"Illā mā syā'allāh(u), innahū ya‘lamul-jahra wa mā yakhfā."},{"ayah":8,"latin":"Wa nuyassiruka lil-yusrā."},{"ayah":9,"latin":"Fa żakkir in nafa‘atiż-żikrā."},{"ayah":10,"latin":"Sayażżakkaru may yakhsyā."},{"ayah":11,"latin":"Wa yatajannabuhal-asyqā."},{"ayah":12,"latin":"Allażī yaṣlan-nāral-kubrā."},{"ayah":13,"latin":"Ṡumma lā yamūtu fīhā wa lā yaḥyā."},{"ayah":14,"latin":"Qad aflaḥa man tazakkā."},{"ayah":15,"latin":"Wa żakarasma rabbihī fa ṣallā."},{"ayah":16,"latin":"Bal tu'ṡirūnal-ḥayātad-dun-yā."},{"ayah":17,"latin":"Wal-ākhiratu khairuw wa abqā."},{"ayah":18,"latin":"Inna hāżā lafiṣ-ṣuḥufil-ūlā."},{"ayah":19,"latin":"Ṣuḥufi ibrāhīma wa mūsā."}]}
