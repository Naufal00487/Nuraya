{"surah":82,"source":"Transliterasi Latin Indonesia · EQuran.id API v2","sourceUrl":"https://equran.id/api/v2/surat/82","verses":[{"ayah":1,"latin":"Iżas-samā'unfaṭarat."},{"ayah":2,"latin":"Wa iżal-kawākibuntaṡarat."},{"ayah":3,"latin":"Wa iżal-biḥāru fujjirat."},{"ayah":4,"latin":"Wa iżal-qubūru bu‘ṡirat."},{"ayah":5,"latin":"‘Alimat nafsum mā qaddamat wa akhkharat."},{"ayah":6,"latin":"Yā ayyuhal-insānu mā garraka birabbikal-karīm(i)."},{"ayah":7,"latin":"Allażī khalaqaka fa sawwāka fa ‘adalak(a)."},{"ayah":8,"latin":"Fī ayyi ṣūratim mā syā'a rakkabak(a)."},{"ayah":9,"latin":"Kallā bal tukażżibūna bid-dīn(i)."},{"ayah":10,"latin":"Wa inna ‘alaikum laḥāfiẓīn(a)."},{"ayah":11,"latin":"Kirāman kātibīn(a)."},{"ayah":12,"latin":"Ya‘lamūna mā taf‘alūn(a)."},{"ayah":13,"latin":"Innal-abrāra lafī na‘īm(in)."},{"ayah":14,"latin":"Wa innal-fujjāra lafī jaḥīm(in)."},{"ayah":15,"latin":"Yaṣlaunahā yaumad-dīn(i)."},{"ayah":16,"latin":"Wa mā hum ‘anhā bigā'ibīn(a)."},{"ayah":17,"latin":"Wa mā adrāka mā yaumud-dīn(i)."},{"ayah":18,"latin":"Ṡumma mā adrāka mā yaumud-dīn(i)."},{"ayah":19,"latin":"Yauma lā tamliku nafsul linafsin syai'ā(n), wal-amru yauma'iżil lillāh(i)."}]}
