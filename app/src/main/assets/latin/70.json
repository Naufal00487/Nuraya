{"surah":70,"source":"Transliterasi Latin Indonesia · EQuran.id API v2","sourceUrl":"https://equran.id/api/v2/surat/70","verses":[{"ayah":1,"latin":"Sa'ala sā'ilum bi‘ażābiw wāqi‘(in)."},{"ayah":2,"latin":"Lil-kāfirīna laisa lahū dāfi‘(un)."},{"ayah":3,"latin":"Minallāhi żil-ma‘ārij(i)."},{"ayah":4,"latin":"Ta‘rujul-malā'ikatu war-rūḥu ilaihi fī yaumin kāna miqdāruhū khamsīna alfa sanah(tin)."},{"ayah":5,"latin":"Faṣbir ṣabran jamīlā(n)."},{"ayah":6,"latin":"Innahum yaraunahū ba‘īdā(n)."},{"ayah":7,"latin":"Wa narāhu qarībā(n)."},{"ayah":8,"latin":"Yauma takūnus-samā'u kal-muhl(i)."},{"ayah":9,"latin":"Wa takūnul-jibālu kal-‘ihn(i)."},{"ayah":10,"latin":"Wa lā yas'alu ḥamīmun ḥamīmā(n)."},{"ayah":11,"latin":"Yubaṣṣarūnahum, yawaddul-mujrimu lau yaftadī  min ‘ażābi yaumi'iżim bibanīh(i)."},{"ayah":12,"latin":"Wa ṣāḥibatihī wa akhīh(i)."},{"ayah":13,"latin":"Wa faṣīlatihil-latī tu'wīh(i)."},{"ayah":14,"latin":"Wa man fil-arḍi jamī‘ā(n), ṡumma yunjīh(i)."},{"ayah":15,"latin":"Kallā, innahā laẓā."},{"ayah":16,"latin":"Nazzā‘atal lisy-syawā."},{"ayah":17,"latin":"Tad‘ū man adbara wa tawallā."},{"ayah":18,"latin":"Wa jama‘a fa'au‘ā."},{"ayah":19,"latin":"Innal-insāna khuliqa halu‘ā(n)."},{"ayah":20,"latin":"Iżā massahusy-syarru jazū‘ā(n)."},{"ayah":21,"latin":"Wa iżā massahul-khairu manū‘ā(n)."},{"ayah":22,"latin":"Illal-muṣallīn(a)."},{"ayah":23,"latin":"Allażīna hum ‘alā ṣalātihim dā'imūn(a)."},{"ayah":24,"latin":"Wal-lażīna fī amwālihim ḥaqqum ma‘lūm(un)."},{"ayah":25,"latin":"Lis-sā'ili wal-maḥrūm(i)."},{"ayah":26,"latin":"Wal-lażīna yuṣaddiqūna biyaumid-dīn(i)."},{"ayah":27,"latin":"Wal-lażīna hum min ‘ażābi rabbihim musyfiqūn(a)."},{"ayah":28,"latin":"Inna ‘ażāba rabbihim gairu ma'mūn(in)."},{"ayah":29,"latin":"Wal-lażīna hum lifurūjihim ḥāfiẓūn(a)."},{"ayah":30,"latin":"Illā ‘alā azwājihim au mā malakat aimānuhum fa innahum gairu malūmīn(a)."},{"ayah":31,"latin":"Fa manibtagā warā'a żālika fa ulā'ika  humul-‘ādūn(a)."},{"ayah":32,"latin":"Wal-lażīna hum li'amānātihim wa ‘ahdihim rā'ūn(a)."},{"ayah":33,"latin":"Wal-lażīna hum bisyahādātihim qā'imūn(a)."},{"ayah":34,"latin":"Wal-lażīna hum ‘alā ṣalātihim yuḥāfiẓūn(a)."},{"ayah":35,"latin":"Ulā'ika fī jannātim mukramūn(a)."},{"ayah":36,"latin":"Famālil-lażīna kafarū qibalaka muhṭi‘īn(a)."},{"ayah":37,"latin":"‘Anil-yamīni wa ‘anisy-syimāli ‘izīn(a)."},{"ayah":38,"latin":"Ayaṭma‘u kullumri'im minhum ay yudkhala jannata na‘īm(in)."},{"ayah":39,"latin":"Kallā, innā khalaqnāhum mimmā ya‘malūn(a)."},{"ayah":40,"latin":"Falā uqsimu birabbil-masyāriqi wal-magāribi  innā laqādirūn(a)."},{"ayah":41,"latin":"‘Alā an nubaddila khairam minhum, wa mā naḥnu bimasbūqīn(a)."},{"ayah":42,"latin":"Fa żarhum yakhūḍū  wa yal‘abū ḥattā yulāqū yaumahumul-lażī yū‘adūn(a)"},{"ayah":43,"latin":"Yauma yakhrujūna minal-ajdāṡi sirā‘an ka'annahum ilā nuṣubiy yūfiḍūn(a)."},{"ayah":44,"latin":"Khāsyi‘atan abṣāruhum tarhaquhum żillah(tun), żālikal-yaumul-lażī kānū yū‘adūn(a)."}]}
