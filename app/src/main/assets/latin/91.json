{"surah":91,"source":"Transliterasi Latin Indonesia · EQuran.id API v2","sourceUrl":"https://equran.id/api/v2/surat/91","verses":[{"ayah":1,"latin":"Wasy-syamsi wa ḍuḥāhā."},{"ayah":2,"latin":"Wal-qamari iżā talāhā."},{"ayah":3,"latin":"Wan-nahāri iżā jallāhā."},{"ayah":4,"latin":"Wal-laili iżā yagsyāhā."},{"ayah":5,"latin":"Was-samā'i wa mā banāhā."},{"ayah":6,"latin":"Wal-arḍi wa mā ṭaḥāhā."},{"ayah":7,"latin":"Wa nafsiw wa mā sawwāhā."},{"ayah":8,"latin":"Fa alhamahā fujūrahā wa taqwāhā."},{"ayah":9,"latin":"Qad aflaḥa man zakkāhā."},{"ayah":10,"latin":"Wa qad khāba man dassāhā."},{"ayah":11,"latin":"Każżabat ṡamūdu biṭagwāhā."},{"ayah":12,"latin":"Iżimba‘aṡa asyqāhā."},{"ayah":13,"latin":"Fa qāla lahum rasūlullāhi nāqatallāhi wa suqyāhā."},{"ayah":14,"latin":"Fa każżabūhu fa ‘aqarūhā fa damdama ‘alaihim rabbuhum biżambihim fa sawwāhā."},{"ayah":15,"latin":"Wa lā yakhāfu ‘uqbāhā."}]}
